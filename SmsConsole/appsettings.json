{
  "SmsClient": {
    // http/grpc
    "Type": "grpc",
    "BaseUrl": "http://localhost:8080",
    "Endpoint": "/api/command",
    "Username": "user",
    "Password": "pass",
    "GrpcAddress": "https://localhost:5001"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=sms-db;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "test-sms-console-app-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}